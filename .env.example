# HireShield AI — copy to .env and edit. Never commit .env.
# Empty values mean "not configured": the platform reports these integrations as
# unavailable instead of inventing results.

# ---------------------------------------------------------------- core
APP_NAME="HireShield AI"
ENVIRONMENT=development
LOG_LEVEL=INFO
# REQUIRED IN PRODUCTION: replace with a long random value (openssl rand -hex 48)
SECRET_KEY=development-only-secret-change-before-launch
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set explicitly in production (comma separated). "*" is development-only.
ALLOWED_HOSTS=*
RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------- login verification
# Cloudflare Turnstile activates only when BOTH keys are set. Without keys the API
# reports status=not_configured and does not simulate a challenge.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: reject tokens solved on a different hostname, e.g. app.example.com.
TURNSTILE_EXPECTED_HOSTNAME=

# ---------------------------------------------------------------- exposed ports / frontend
# Compose host ports. Inside the stack the API is always api:8000.
API_PORT=8000
WEB_PORT=3000
# Baked into the frontend image at build time; keep /api/v1 when using the bundled nginx proxy.
VITE_API_URL=/api/v1

# ---------------------------------------------------------------- persistence / workers
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=hireshield
REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=true
TASK_ALWAYS_EAGER=false
SCHEDULER_ENABLED=true
MONITORING_INTERVAL_MINUTES=60
DOMAIN_REFRESH_INTERVAL_HOURS=24
HEALTH_CHECK_INTERVAL_MINUTES=5
RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730

# ---------------------------------------------------------------- storage / uploads
# Relative to the API working directory. In Docker this is /app/models.
MODEL_DIR=./backend/models
DATA_DIR=./backend/data
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_MIME=application/pdf,image/png,image/jpeg,image/webp,text/plain
MAX_FETCH_BYTES=262144
FETCH_TIMEOUT_SECONDS=8
MAX_REDIRECTS=4

# ---------------------------------------------------------------- local demo accounts
# Development only. In production seeding is automatically disabled unless strong
# DEMO_PASSWORD and ADMIN_PASSWORD values are supplied.
SEED_DEMO_DATA=true
DEMO_EMAIL=demo@hireshield.io
DEMO_PASSWORD=DemoPass123!
ADMIN_EMAIL=admin@hireshield.io
ADMIN_PASSWORD=AdminPass123!

# ---------------------------------------------------------------- external intelligence
VIRUSTOTAL_API_KEY=
# Safe Browsing v4 is non-commercial; use GOOGLE_WEBRISK_API_KEY for commercial products.
GOOGLE_SAFEBROWSING_API_KEY=
GOOGLE_WEBRISK_API_KEY=
# MCA has no official public API. Use a licensed/bulk-provider endpoint only.
MCA_API_URL=
MCA_API_KEY=
MCA_REQUIRE_CONSENT=true
RDAP_ENABLED=true
DNS_ENABLED=true
TLS_ENABLED=true

# Only URLs explicitly listed here are fetched by monitoring jobs.
JOB_SOURCE_URLS=
JOB_SOURCE_API_KEYS=
JOB_SOURCE_MAX_PER_RUN=100

# ---------------------------------------------------------------- notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="HireShield AI <no-reply@hireshield.io>"
SMTP_USE_TLS=true
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=HireShield
NOTIFY_EMAIL_ON_HIGH_RISK=true

# ---------------------------------------------------------------- billing
# Paid access is granted only by HMAC-verified Razorpay/Stripe webhooks.
# Razorpay: see docs/RAZORPAY_SETUP.md for dashboard, webhook and test steps.
# KEY_ID is public (returned to the browser); KEY_SECRET and WEBHOOK_SECRET are private.
# rzp_test_ keys show "test mode" in the UI; rzp_live_ keys show "live mode".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate secret from Razorpay -> Settings -> Webhooks. Required for activation.
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Smallest currency unit basis. Prices are stored as paise/cents in the plans collection.
PAYMENT_CURRENCY=INR

# ---------------------------------------------------------------- plan defaults
# Seeded once into MongoDB, then editable through the admin API.
FREE_SCAN_LIMIT=10
STUDENT_SCAN_LIMIT=100
PROFESSIONAL_SCAN_LIMIT=500
UNIVERSITY_SCAN_LIMIT=5000
ENTERPRISE_SCAN_LIMIT=100000

# ---------------------------------------------------------------- risk weights
RISK_WEIGHT_ML=0.28
RISK_WEIGHT_RULES=0.24
RISK_WEIGHT_DOMAIN=0.18
RISK_WEIGHT_COMPANY=0.14
RISK_WEIGHT_HISTORY=0.10
RISK_WEIGHT_MESSAGE=0.06
