# Copy to .env and replace secrets before running.
ENVIRONMENT=development
LOG_LEVEL=INFO
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=threat_intel
API_KEY=replace-with-a-long-random-value
AUTH_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SCHEDULER_ENABLED=true
CHANGE_STREAM_ENABLED=true
COLLECTION_INTERVAL_MINUTES=5
DETECTION_INTERVAL_MINUTES=2
ENRICHMENT_INTERVAL_MINUTES=10
CORRELATION_INTERVAL_MINUTES=3
HEALTH_INTERVAL_MINUTES=1

# A source is collected only when listed in BOTH variables.
AUTHORIZED_SOURCES=windows_eventlog,windows_eventlog_file,application_log,urlhaus_feed
ENABLED_SOURCES=windows_eventlog,windows_eventlog_file

WINDOWS_EVENTLOG_ENABLED=true
WINDOWS_EVENTLOG_CHANNELS=Security,System,Microsoft-Windows-PowerShell/Operational
WINDOWS_EVENTLOG_EVENT_IDS=1102,4624,4625,4634,4647,4672,4688,4697,4720,4722,4723,4724,4732,4735,4737,4758,4767,7045,4103,4104
WINDOWS_EVENTLOG_MAX_EVENTS=500
WINDOWS_EVENTLOG_LOOKBACK_MINUTES=10
WINDOWS_EVENTLOG_XML_PATH=
APPLICATION_LOG_PATH=
APPLICATION_LOG_FORMAT=jsonl
URLHAUS_FEED_ENABLED=false

TI_ENABLED=true
ABUSEIPDB_API_KEY=
URLHAUS_API_KEY=
TI_CACHE_TTL_HOURS=24
TI_RATE_LIMIT_PER_MINUTE=30
TI_FEED_MAX_RECORDS=200

RULE_FAILED_LOGIN_THRESHOLD=5
RULE_FAILURE_WINDOW_MINUTES=10
RULE_BRUTE_FORCE_ACCOUNTS=3
RULE_BRUTE_FORCE_THRESHOLD=10
RULE_SUCCESS_AFTER_FAILURES=3
RULE_SUCCESS_AFTER_FAILURES_WINDOW_MINUTES=30
RULE_UNUSUAL_HOURS_START=22
RULE_UNUSUAL_HOURS_END=6
RULE_API_RATE_THRESHOLD=120
RULE_MALICIOUS_CONFIDENCE=0.65
CRITICAL_ASSET_CRITICALITY=4
ML_MIN_TRAIN_SAMPLES=200

RISK_WEIGHT_TI=0.30
RISK_WEIGHT_ML=0.20
RISK_WEIGHT_RULE=0.25
RISK_WEIGHT_ASSET=0.15
RISK_WEIGHT_CORRELATION=0.10

CORRELATION_WINDOW_HOURS=24
EVENT_RETENTION_DAYS=90
DETECTION_RETENTION_DAYS=90
INCIDENT_RETENTION_DAYS=365
NOTIFICATION_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365
JOB_RETENTION_DAYS=30

ALERT_MIN_SEVERITY=high
ALERT_EMAILS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WEBHOOK_URL=
WEBHOOK_SECRET=
RESPONSE_ACTIONS_ENABLED=false

MODEL_DIR=./models
IF_CONTAMINATION=0.05

VITE_API_URL=/api/v1
VITE_API_KEY=replace-with-a-long-random-value
